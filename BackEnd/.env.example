# ============================================================
# Variables de entorno del BackEnd (Express)
# ============================================================
# Copiar este archivo a BackEnd/.env.local y rellenar los valores.
# NUNCA commitear .env ni .env.local (están en .gitignore).

# --- Supabase (obligatorio) ---------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave service_role. OJO: omite RLS por completo, así que es la llave maestra
# de la base. Solo en el servidor, jamás en el frontend ni en el navegador.
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=

# --- Firma de enlaces por correo (obligatorio) --------------
# Firma los tokens de restablecer contraseña, confirmar correo, aprobar cuentas
# y aceptar un match desde el correo.
#
# Poné acá un valor aleatorio y largo, propio de este despliegue. Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Si se deja vacío, el backend reutiliza SUPABASE_SECRET_KEY (funciona, pero es
# mala higiene: una misma clave para dos propósitos distintos). Si faltan las
# dos, el servidor NO arranca, a propósito: antes caía en un valor por defecto
# que está publicado en el repositorio, y con él cualquiera podía falsificar un
# enlace de restablecer contraseña y tomar una cuenta ajena.
APPROVAL_SECRET=

# --- Frontend -----------------------------------------------
# URL pública del FE. Se usa para el allowlist de CORS y para armar los enlaces
# que van en los correos.
FRONTEND_URL=http://localhost:3000
APP_BACKEND_URL=http://localhost:5000

# --- Correo (Resend) ----------------------------------------
RESEND_API_KEY=
RESEND_FROM=Alumni UCR <no-reply@tu-dominio.com>
# Correo del admin que recibe los avisos de aprobación de cuentas.
APROBACION_CORREO=

# --- IA -----------------------------------------------------
# Necesaria para el chatbot y el asistente de CV.
ANTHROPIC_API_KEY=
# Opcional: modelo por defecto si se quiere cambiar.
# CLAUDE_MODEL=claude-sonnet-5

# Generación de imágenes (opcional; hoy ninguna pantalla la consume).
REPLICATE_API_TOKEN=

# --- Varios -------------------------------------------------
PORT=5000
NODE_ENV=development
# RF-01.1: true exige correo @ucr.ac.cr al registrar estudiantes.
STRICT_UCR_EMAIL=true
